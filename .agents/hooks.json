{
  "security-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|replace_file_content|multi_replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/security_guard.cjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
